{
  "name": "@km0/desktop",
  "productName": "KM0",
  "version": "1.0.0",
  "private": true,
  "description": "KM0 desktop app",
  "author": "WERvEX",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && pnpm build:mcp",
    "build:mcp": "esbuild src/mcp/main.ts --bundle --platform=node --format=cjs --target=node22 --log-level=warning --outfile=out/mcp/km0-mcp.cjs",
    "preview": "electron-vite preview",
    "package": "electron-vite build && pnpm build:mcp && electron-builder --publish never",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json && tsc -p tsconfig.webapp.json",
    "test": "vitest run",
    "web:dev": "vite --config vite.web.config.ts",
    "web:build": "vite build --config vite.web.config.ts",
    "web:preview": "vite preview --config vite.web.config.ts",
    "live-run": "vitest run --config vitest.live.config.ts"
  },
  "devDependencies": {
    "@hookform/resolvers": "5.9.2",
    "@km0/core": "workspace:*",
    "@km0/registry": "workspace:*",
    "@km0/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-slot": "1.5.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.104.4",
    "@tanstack/react-router": "1.170.45",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sql.js": "1.4.11",
    "@vitejs/plugin-react": "6.1.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "electron-log": "5.4.4",
    "electron-updater": "6.8.10",
    "electron-vite": "6.0.0",
    "esbuild": "0.28.2",
    "fflate": "0.8.2",
    "i18next": "26.5.2",
    "jsdom": "30.1.3",
    "lucide-react": "1.59.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "react-i18next": "17.1.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "sql.js": "1.14.2",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  }
}
